# Copy these into Vercel Project Settings > Environment Variables.
# Never add real keys to GitHub or frontend variables.
GEMINI_API_KEY=
# Current supported model ID can be overridden if needed.
GEMINI_MODEL=gemini-2.5-flash
HINDSIGHT_API_KEY=
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_BANK_ID=pennywise-demo
# This unauthenticated deployment is intentionally a single-user demo.
DEMO_MODE=true